<?xml version="1.0" encoding="utf-8"?>
<!-- CashWise subtle light gradient: light teal (#CCFBF1) -> light indigo (#E0E7FF), diagonal.
     Same background used on iOS & Desktop so the icon is consistent across platforms. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:startColor="#CCFBF1"
        android:endColor="#E0E7FF"
        android:type="linear"
        android:angle="315" />
</shape>
